# Camp Prep AI environment configuration
# Copy this file to .env and fill in values ONLY if you want to leave demo mode.
# The application runs fully without any of these set (local demo mode).

# --- Supabase (optional; Phase 2 persistence) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- AI grading: Google Gemini (free tier works) ---
# Key from https://aistudio.google.com/apikey. Leave empty for rule-based grading.
LLM_API_KEY=
LLM_MODEL=gemini:gemini-2.5-flash
