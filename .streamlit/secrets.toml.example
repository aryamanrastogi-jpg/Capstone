# Paste these into Streamlit Community Cloud -> App settings -> Secrets.
# Keep every key at root level (no [section] header). Streamlit exposes
# root-level secrets as environment variables, which is how utils/config.py
# reads them.
# The service_role key below is used ONLY by the Admin page, after the
# passkey checks out (services/admin_service.py). It bypasses Row Level
# Security: keep it in Streamlit secrets only - never in the repo, a .env that
# is committed, a screenshot or a chat.

SUPABASE_URL = ""
SUPABASE_PUBLISHABLE_KEY = ""
LLM_API_KEY = ""   # Gemini key from https://aistudio.google.com/apikey
LLM_MODEL = "gemini:gemini-3.8-flash"

# Admin page (/admin). Leave both empty to keep admin switched off.
# ADMIN_PASSKEY: at least 16 characters, random. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_PASSKEY = ""
SUPABASE_SERVICE_ROLE_KEY = ""   # Supabase > Project Settings > API keys
