{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "campprep",
      "runtimeExecutable": ".venv/Scripts/streamlit.exe",
      "runtimeArgs": [
        "run",
        "app.py",
        "--server.port",
        "8501",
        "--server.headless",
        "true"
      ],
      "port": 8501
    },
    {
      "name": "campprep-ui",
      "runtimeExecutable": ".venv/Scripts/streamlit.exe",
      "runtimeArgs": [
        "run",
        "app.py",
        "--server.port",
        "8503",
        "--server.headless",
        "true"
      ],
      "port": 8503
    },
    {
      "name": "campprep-demo",
      "runtimeExecutable": ".venv/Scripts/streamlit.exe",
      "runtimeArgs": [
        "run",
        "app.py",
        "--server.port",
        "8504",
        "--server.headless",
        "true"
      ],
      "port": 8504,
      "env": {
        "SUPABASE_URL": "",
        "SUPABASE_PUBLISHABLE_KEY": "",
        "LLM_API_KEY": "",
        "LLM_MODEL": ""
      }
    }
  ]
}
